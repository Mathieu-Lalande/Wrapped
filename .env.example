# Copier ce fichier en .env (jamais commité) et renseigner les valeurs.

# Fine-grained personal access token GitHub, en lecture seule (voir README).
GITHUB_TOKEN=

# Origine(s) autorisée(s) en CORS, séparées par des virgules.
WRAPPED_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting par IP : nombre de requêtes par fenêtre (durée Spring Boot : 30s, 1m, 1h…)
WRAPPED_RATE_LIMIT_MAX_REQUESTS=30
WRAPPED_RATE_LIMIT_WINDOW=1m
